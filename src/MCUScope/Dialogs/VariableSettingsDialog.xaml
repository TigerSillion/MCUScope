<Window x:Class="MCUScope.Dialogs.VariableSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MCUScope.ViewModels"
        Title="Variable Settings" Height="500" Width="750"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="8">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="OK" Width="80" Margin="4" Click="OnOk" IsDefault="True"/>
            <Button Content="Cancel" Width="80" Margin="4" Click="OnCancel" IsCancel="True"/>
        </StackPanel>

        <DataGrid x:Name="VariableGrid" AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  GridLinesVisibility="All" FontSize="11" RowHeight="24">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Width="120" Binding="{Binding Name}" IsReadOnly="True"/>
                <DataGridTextColumn Header="Address" Width="90" Binding="{Binding Address, StringFormat=0x{0:X8}}" IsReadOnly="True"/>
                <DataGridTextColumn Header="Original Type" Width="90" Binding="{Binding OriginalType}" IsReadOnly="True"/>
                <DataGridComboBoxColumn Header="Modified Type" Width="100"
                    SelectedItemBinding="{Binding ModifiedType}"
                    ItemsSource="{Binding Source={x:Static vm:EnumValues.VariableTypes}}"/>
                <DataGridTextColumn Header="Scale" Width="70" Binding="{Binding Scale}"/>
                <DataGridCheckBoxColumn Header="Read" Width="45" Binding="{Binding ReadEnabled}"/>
                <DataGridCheckBoxColumn Header="Write" Width="45" Binding="{Binding WriteEnabled}"/>
                <DataGridTextColumn Header="Alias" Width="80" Binding="{Binding Alias}"/>
                <DataGridTextColumn Header="Comment" Width="*" Binding="{Binding Comment}"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
