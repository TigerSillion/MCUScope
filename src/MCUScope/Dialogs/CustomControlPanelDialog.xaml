<Window x:Class="MCUScope.Dialogs.CustomControlPanelDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Custom Control Panel" Height="400" Width="500"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="8">
        <TextBlock DockPanel.Dock="Top" Text="Custom Control Panel" FontWeight="Bold" Margin="0,4"/>
        <TextBlock DockPanel.Dock="Top" Margin="0,4" FontSize="11" Foreground="Gray" TextWrapping="Wrap"
                   Text="Define custom controls to read/write variables with sliders, buttons, and input fields. Add controls below to create your custom panel."/>

        <!-- Toolbar -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,4">
            <Button Content="Add Slider" Width="80" Margin="4" Click="OnAddSlider"/>
            <Button Content="Add Toggle" Width="80" Margin="4" Click="OnAddToggle"/>
            <Button Content="Add Display" Width="80" Margin="4" Click="OnAddDisplay"/>
            <Button Content="Clear All" Width="80" Margin="4" Click="OnClearAll"/>
        </StackPanel>

        <!-- Control Panel Area -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ControlPanel" Margin="4"/>
        </ScrollViewer>
    </DockPanel>
</Window>
