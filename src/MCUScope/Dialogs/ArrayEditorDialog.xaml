<Window x:Class="MCUScope.Dialogs.ArrayEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MCUScope.ViewModels"
        Title="Array Editor" Height="500" Width="700"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="8">
        <!-- Settings Panel -->
        <GroupBox DockPanel.Dock="Top" Header="Array Settings" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Origin:" Margin="4" VerticalAlignment="Center"/>
                <ComboBox Grid.Row="0" Grid.Column="1" x:Name="OriginCombo" Margin="4" Width="120"
                          IsEditable="True"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Offset:" Margin="4" VerticalAlignment="Center"/>
                <TextBox Grid.Row="0" Grid.Column="3" x:Name="OffsetBox" Text="0x00000000" Margin="4" Width="100"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Type:" Margin="4" VerticalAlignment="Center"/>
                <ComboBox Grid.Row="1" Grid.Column="1" x:Name="TypeCombo" Margin="4" Width="120"
                          ItemsSource="{Binding Source={x:Static vm:EnumValues.VariableTypes}}"
                          SelectedIndex="5"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="Start:" Margin="4" VerticalAlignment="Center"/>
                <TextBox Grid.Row="1" Grid.Column="3" x:Name="StartBox" Text="0" Margin="4" Width="60"/>
                <TextBlock Grid.Row="1" Grid.Column="4" Text="Count:" Margin="4" VerticalAlignment="Center"/>
                <TextBox Grid.Row="1" Grid.Column="5" x:Name="CountBox" Text="64" Margin="4" Width="60"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Columns:" Margin="4" VerticalAlignment="Center"/>
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="ColumnsBox" Text="8" Margin="4" Width="60"/>
                <TextBlock Grid.Row="2" Grid.Column="2" Text="Scale:" Margin="4" VerticalAlignment="Center"/>
                <TextBox Grid.Row="2" Grid.Column="3" x:Name="ScaleBox" Text="1.0" Margin="4" Width="60"/>
                <TextBlock Grid.Row="2" Grid.Column="4" Text="Format:" Margin="4" VerticalAlignment="Center"/>
                <ComboBox Grid.Row="2" Grid.Column="5" x:Name="FormatCombo" Margin="4" Width="80">
                    <ComboBoxItem Content="Decimal" IsSelected="True"/>
                    <ComboBoxItem Content="Hex"/>
                    <ComboBoxItem Content="Float"/>
                </ComboBox>
            </Grid>
        </GroupBox>

        <!-- Action buttons -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
            <Button Content="READ" Width="80" Margin="4" Click="OnRead"/>
            <Button Content="WRITE" Width="80" Margin="4" Click="OnWrite"/>
            <Button Content="Export CSV" Width="80" Margin="4" Click="OnExportCsv"/>
            <Button Content="Import CSV" Width="80" Margin="4" Click="OnImportCsv"/>
        </StackPanel>

        <!-- Data Grid -->
        <DataGrid x:Name="ArrayDataGrid" AutoGenerateColumns="True"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  GridLinesVisibility="All" FontSize="11" RowHeight="22"/>
    </DockPanel>
</Window>
