<UserControl x:Class="MCUScope.Views.VariableBrowserPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DockPanel>
        <!-- Filter bar -->
        <StackPanel DockPanel.Dock="Top" Margin="4,4,4,2">
            <!-- Search -->
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource {x:Type TextBox}}" Margin="0,0,0,3" FontSize="11">
                <TextBox.Tag>Search variables...</TextBox.Tag>
            </TextBox>

            <!-- Filter combos -->
            <WrapPanel Margin="0,0,0,2">
                <TextBlock Text="Type:" FontSize="11" VerticalAlignment="Center" Margin="0,0,2,0"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
                <ComboBox ItemsSource="{Binding TypeOptions}" SelectedItem="{Binding TypeFilter}"
                          Width="70" FontSize="11" Margin="0,0,4,0"/>

                <TextBlock Text="Scope:" FontSize="11" VerticalAlignment="Center" Margin="0,0,2,0"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
                <ComboBox SelectedItem="{Binding ScopeFilter}" Width="60" FontSize="11" Margin="0,0,4,0">
                    <ComboBoxItem Content="All"/>
                    <ComboBoxItem Content="Global"/>
                    <ComboBoxItem Content="Local"/>
                    <ComboBoxItem Content="Struct"/>
                </ComboBox>

                <TextBlock Text="Cat:" FontSize="11" VerticalAlignment="Center" Margin="0,0,2,0"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
                <ComboBox ItemsSource="{Binding CategoryOptions}" SelectedItem="{Binding CategoryFilter}"
                          Width="60" FontSize="11"/>
            </WrapPanel>

            <!-- Quick prefix buttons + actions -->
            <WrapPanel Margin="0,0,0,2">
                <Button Content="com_" FontSize="10" Padding="4,1" Margin="1"
                        Command="{Binding SetPrefixFilterCommand}" CommandParameter="com_"/>
                <Button Content="g_" FontSize="10" Padding="4,1" Margin="1"
                        Command="{Binding SetPrefixFilterCommand}" CommandParameter="g_"/>
                <Button Content="st_" FontSize="10" Padding="4,1" Margin="1"
                        Command="{Binding SetPrefixFilterCommand}" CommandParameter="g_st_"/>
                <Button Content="Clear" FontSize="10" Padding="4,1" Margin="1"
                        Command="{Binding ClearFilterCommand}"/>
                <Button Content="Read" FontSize="10" Padding="4,1" Margin="1" FontWeight="Bold"
                        Command="{Binding ReadSelectedCommand}"/>
            </WrapPanel>

            <!-- Status -->
            <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2">
                <Run Text="Showing "/>
                <Run Text="{Binding FilteredCount, Mode=OneWay}"/>
                <Run Text=" / "/>
                <Run Text="{Binding TotalCount, Mode=OneWay}"/>
                <Run Text=" variables"/>
            </TextBlock>
        </StackPanel>

        <!-- Variable list -->
        <DataGrid x:Name="VariableGrid"
                  ItemsSource="{Binding ItemsView}" AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  IsReadOnly="True" SelectionMode="Extended"
                  FontSize="11" RowHeight="22" HeadersVisibility="Column"
                  Background="{StaticResource PanelBgBrush}"
                  Foreground="{StaticResource TextPrimaryBrush}"
                  BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                  PreviewMouseLeftButtonDown="OnVariableGridPreviewMouseLeftButtonDown"
                  MouseMove="OnVariableGridMouseMove">
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Add to Scope Channel"
                              Command="{Binding AddToScopeCommand}"
                              CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    <MenuItem Header="Add to Watch"
                              Command="{Binding AddToWatchCommand}"
                              CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    <Separator/>
                    <MenuItem Header="Copy Variable Name"
                              Command="{Binding CopyNameCommand}"
                              CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    <MenuItem Header="Read Value"
                              Command="{Binding ReadSingleVariableCommand}"
                              CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Width="*" MinWidth="100" Binding="{Binding Name}"
                                    SortMemberPath="Name"/>
                <DataGridTextColumn Header="Address" Width="80" Binding="{Binding AddressHex}"
                                    SortMemberPath="Address"/>
                <DataGridTextColumn Header="Type" Width="70" Binding="{Binding TypeText}"
                                    SortMemberPath="Type"/>
                <DataGridTextColumn Header="Size" Width="35" Binding="{Binding SizeText}"
                                    SortMemberPath="Size"/>
                <DataGridTextColumn Header="S" Width="30" Binding="{Binding ScopeText}"
                                    SortMemberPath="IsGlobal"/>
                <DataGridTextColumn Header="Cat" Width="55" Binding="{Binding Category}"
                                    SortMemberPath="Category"/>
                <DataGridTemplateColumn Header="Value" Width="80" SortMemberPath="Value">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock FontSize="11" VerticalAlignment="Center" Margin="2,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="---"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasValue}" Value="True">
                                                <Setter Property="Text" Value="{Binding Value, StringFormat={}{0:G6}}"/>
                                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
